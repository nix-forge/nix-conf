# shellcheck shell=bash
# The Nix builder supplies the output path and wrapper function.
# shellcheck disable=SC2154
runHook preInstall
mkdir -p "$out/lib" "$out/bin"
cp -R node_modules "$out/lib/node_modules"
makeWrapper @node@ "$out/bin/oxlint" \
  --add-flags "$out/lib/node_modules/oxlint/bin/oxlint"
makeWrapper @node@ "$out/bin/prettier" \
  --add-flags "$out/lib/node_modules/prettier/bin/prettier.cjs"
makeWrapper @node@ "$out/bin/tsc" \
  --add-flags "$out/lib/node_modules/typescript/bin/tsc"
runHook postInstall
