root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.nix]
indent_size = 2

[*.rs]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
# Markdown list continuations must align beneath the marker; their indentation
# therefore varies with the number of digits in the list marker. Rumdl owns
# Markdown formatting and linting, so do not impose a fixed EditorConfig width.
indent_size = unset

[Makefile]
indent_style = tab

[.gitmodules]
indent_style = tab

[docs/assets/**/*.txt]
# Captured tool output retains its original tabs and column alignment.
indent_style = unset
indent_size = unset

[docs/assets/hyprland-upstream-local-20260907/**]
# Captured evidence must retain the original content and checksums.
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
