{
  "private": true,
  "scripts": {
    "typecheck": "node tests/typescript/check-projects.mts",
    "lint": "oxlint --type-aware --deny-warnings --config .oxlintrc.json tests overlays/temporary/patches/*-test.cts",
    "format:check": "prettier --check \"tests/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}\" \"overlays/temporary/patches/*-test.cts\" package.json tsconfig.json .oxlintrc.json tests/typescript/projects.json",
    "test": "node --test tests/*/*.test.mts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
