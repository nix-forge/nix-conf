+
+static void assert_trailing_slash_symlink_removes_only_link(const char *suffix)
+{
+	git_str link = GIT_STR_INIT, target = GIT_STR_INIT;
+
+	cl_git_pass(git_str_joinpath(&link, empty_tmp_dir, "link"));
+	cl_git_pass(git_str_joinpath(&target, empty_tmp_dir, "one/sentinel.txt"));
+	cl_git_mkfile(target.ptr, "preserve target");
+	cl_must_pass(p_symlink("one", link.ptr));
+	cl_git_pass(git_str_puts(&link, suffix));
+
+	cl_git_pass(git_futils_rmdir_r(link.ptr, NULL, GIT_RMDIR_REMOVE_FILES));
+	cl_assert(git_fs_path_isfile(target.ptr));
+	cl_assert_equal_file("preserve target", sizeof("preserve target") - 1, target.ptr);
+	cl_assert(!git_fs_path_exists(link.ptr));
+
+	git_str_dispose(&link);
+	git_str_dispose(&target);
+}
+
+void test_rmdir__does_not_follow_symlink_with_trailing_slash(void)
+{
+	assert_trailing_slash_symlink_removes_only_link("/");
+}
+
+void test_rmdir__does_not_follow_symlink_with_multiple_trailing_slashes(void)
+{
+	assert_trailing_slash_symlink_removes_only_link("///");
+}
