    const requestedFace = (face || "").toLowerCase();
    const latinFamily = (charset === 0 || charset === 1)
      ? ["courier", "mono", "consolas", "menlo"].some((name) => requestedFace.includes(name))
        ? "LiberationMono"
        : ["helvetica", "arial", "sans", "nimbus"].some((name) => requestedFace.includes(name))
          ? "LiberationSans"
          : ["times", "serif", "georgia", "cambria"].some((name) => requestedFace.includes(name))
            ? "LiberationSerif"
            : null
      : null;
    const style = (weight >= 600 ? "Bold" : "") + (italic ? "Italic" : "");
    const selectedUrl = latinFamily
      ? `${this.fontConfig.baseUrl}/${latinFamily}-${style || "Regular"}.ttf`
      : result?.url;
