 impl SwitchRoot {
+    fn cancel_switch(&mut self, event_time: u32) {
+        self.cancelled_at = Some((event_time, Instant::now()));
+        self.open = false;
+        self.close_switch(false);
+    }
+
+    fn start_modifier_check(&mut self, sender: &ComponentSender<Self>) {
+        self.stop_modifier_check();
+        if !self.modifier_query_supported {
+            return;
+        }
+        self.modifier_deadline = Some(Instant::now() + MODIFIER_RECONCILIATION_WINDOW);
+        let sender = sender.input_sender().clone();
+        // Transparent compositor release binds and the GTK release controller
+        // are the primary signals. Briefly reconcile the initial focus handoff:
+        // a release there can otherwise precede both notification consumers.
+        self.modifier_check = Some(glib::timeout_add_local(
+            MODIFIER_CHECK_INTERVAL,
+            move || {
+                sender.emit(SwitchRootInput::CheckModifier);
+                ControlFlow::Continue
+            },
+        ));
+    }
+
+    fn stop_modifier_check(&mut self) {
+        self.modifier_deadline = None;
+        if let Some(source) = self.modifier_check.take() {
+            source.remove();
+        }
+        self.cancel_modifier_request();
+    }
+
+    fn cancel_modifier_request(&mut self) {
+        self.modifier_request_id = self.modifier_request_id.wrapping_add(1);
+        if let Some(request) = self.modifier_request.take() {
+            // Destroying the task drops the future, closing its IPC socket.
+            request.abort();
+        }
+    }
+
+    fn request_modifier_check(&mut self, sender: &ComponentSender<Self>, refresh: bool) {
+        if !self.open || (self.modifier_request.is_some() && !refresh) {
+            return;
+        }
+        if !self.modifier_query_supported {
