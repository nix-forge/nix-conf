+/// Read both modifier keys in one nonblocking compositor request.
+#[cfg(any(feature = "async-lite", feature = "tokio"))]
+pub async fn modifier_is_down(left: &str, right: &str) -> crate::Result<Option<bool>> {
+    let response = default_instance()?
+        .write_to_socket_async(command!(
+            Empty,
+            "repl if type(hl.is_key_down) ~= \"function\" then return \"unsupported\" end; return hl.is_key_down({:?}) or hl.is_key_down({:?})",
+            left,
+            right
+        ))
+        .await?;
+    match response.trim() {
+        "true" => Ok(Some(true)),
+        "false" => Ok(Some(false)),
+        "unsupported" | "unknown request" => Ok(None),
+        _ => Err(crate::error::HyprError::NotOkDispatch(response)),
+    }
+}
