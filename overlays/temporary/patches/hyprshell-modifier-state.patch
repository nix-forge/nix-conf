+#[cfg(test)]
+mod event_time_tests {
+    use super::{CANCELLATION_WINDOW, event_is_cancelled};
+    use std::time::{Duration, Instant};
+
+    #[test]
+    fn cancellation_rejects_old_events_but_accepts_the_next_chord() {
+        let recorded = Instant::now();
+        let now = recorded + Duration::from_millis(300);
+        let cancelled = Some((100, recorded));
+        assert!(event_is_cancelled(Some(99), cancelled, now));
+        assert!(event_is_cancelled(Some(100), cancelled, now));
+        assert!(!event_is_cancelled(Some(101), cancelled, now));
+        assert!(!event_is_cancelled(None, cancelled, now));
+        assert!(!event_is_cancelled(Some(99), None, now));
+    }
+
+    #[test]
+    fn cancellation_handles_timestamp_wraparound() {
+        let now = Instant::now();
+        assert!(event_is_cancelled(Some(u32::MAX - 2), Some((2, now)), now));
+        assert!(!event_is_cancelled(Some(2), Some((u32::MAX - 2, now)), now));
+    }
+
+    #[test]
+    fn cancellation_expires_after_the_local_ipc_window() {
+        let recorded = Instant::now();
+        let cancelled = Some((100, recorded));
+        let deadline = recorded + CANCELLATION_WINDOW;
+        assert!(event_is_cancelled(Some(99), cancelled, deadline));
+        assert!(!event_is_cancelled(
+            Some(99),
+            cancelled,
+            deadline + Duration::from_nanos(1),
+        ));
+    }
+
+    #[test]
+    fn cancellation_does_not_swallow_chords_after_half_a_timestamp_cycle() {
+        let recorded = Instant::now();
+        let elapsed_ms = 1_u32 << 31;
+        let now = recorded + Duration::from_millis(u64::from(elapsed_ms));
+        let event = 100_u32.wrapping_add(elapsed_ms);
+        assert!(!event_is_cancelled(Some(event), Some((100, recorded)), now));
+    }
+}
