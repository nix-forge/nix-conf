+// Wayland timestamps wrap at u32::MAX. Signed subtraction orders only events
+// less than half that range apart, so an old cancellation must expire using a
+// monotonic clock. Five seconds covers delayed local IPC across many 150 ms
+// modifier-query deadlines; it is not a guarantee for arbitrarily delayed opens.
+fn event_is_cancelled(
+    event: Option<u32>,
+    cancelled_at: Option<(u32, Instant)>,
+    now: Instant,
+) -> bool {
+    event
+        .zip(cancelled_at)
+        .is_some_and(|(event, (cancelled, recorded))| {
+            now.duration_since(recorded) <= CANCELLATION_WINDOW
+                && event.wrapping_sub(cancelled) as i32 <= 0
+        })
+}
