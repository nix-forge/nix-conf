+#[test]
+fn native_keyboard_input_clears_resume_guard_without_changing_focus_or_layout() {
+    let mut reactor = test_reactor();
+    reactor.handle_event(Event::SessionDidBecomeActive);
+    assert!(reactor.suppress_auto_workspace_switch_until_input);
+    let focus = reactor.main_window();
+    let command_space = reactor.space_state.command_space;
+
+    reactor.handle_loop_event(Event::UserInput);
+
+    assert!(!reactor.suppress_auto_workspace_switch_until_input);
+    assert_eq!(reactor.main_window(), focus);
+    assert_eq!(reactor.space_state.command_space, command_space);
+    // A later lifecycle transition still quarantines synthetic activations.
+    reactor.handle_event(Event::SessionDidBecomeActive);
+    assert!(reactor.suppress_auto_workspace_switch_until_input);
+}
