--- a/src/render/shaders/glsl/rounding.glsl
+++ b/src/render/shaders/glsl/rounding.glsl
@@ -10,6 +10,12 @@
 
 vec4 rounding(vec4 color, float radius, float roundingPower, vec2 topLeft, vec2 fullSize) {
     vec2 pixCoord = vec2(gl_FragCoord);
+#if USE_WINDOW_ROUNDING
+    // wl_subsurface permits content outside its parent. Only remove the
+    // corner cutouts inside the parent rectangle, preserving that overflow.
+    if (any(lessThan(pixCoord, topLeft)) || any(greaterThanEqual(pixCoord, topLeft + fullSize)))
+        return color;
+#endif
     pixCoord -= topLeft + fullSize * 0.5;
     pixCoord *= vec2(lessThan(pixCoord, vec2(0.0))) * -2.0 + 1.0;
     pixCoord -= fullSize * 0.5 - radius;
