{
  # Public values only. Copy this file to .nix-seal/public.nix and replace every
  # placeholder before enabling nix-seal on a real target. Private identities
  # and signing keys must remain outside this repository and the Nix store.
  administratorRecipient = "age1replace-with-a-real-administrator-recipient";
  recoveryRecipient = "age1replace-with-a-separate-recovery-recipient";
  signerPublicKey = "nix-seal-ed25519-v1:replace-with-a-real-release-signer";

  # Each entry is emitted by the reviewed provisioning/cache-export workflow.
  # cacheKey identifies an artifact in the locked ciphertext-only cache-export
  # flake input. Each bundle contains ciphertext.age and manifest.dsse.json.
  artifacts = {
    # "host/nixos/desktop"."ianhollow/nix-access-tokens/system" = {
    #   cacheKey = "64-lowercase-hex-characters";
    #   sourceCiphertextHash = "64-lowercase-hex-characters";
    #   artifactGeneration = 1;
    # };
  };
}
