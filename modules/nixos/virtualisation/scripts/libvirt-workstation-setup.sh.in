#!@bash@
# shellcheck shell=bash disable=SC2239
set -euo pipefail

export LC_ALL=C

libvirt_uri=@libvirtUri@
network_manifest=@networkManifest@
guest_manifest=@guestManifest@
pool_name=@poolName@
pool_path=@poolPath@
pool_definition=@poolDefinition@
temporary_network_definition=
temporary_pool_definition=

cleanup() {
  if [[ -n $temporary_network_definition ]]; then
    @rm@ -f -- "$temporary_network_definition"
  fi
  if [[ -n $temporary_pool_definition ]]; then
    @rm@ -f -- "$temporary_pool_definition"
  fi
}
trap cleanup EXIT

while IFS=$'\t' read -r network_name _bridge _subnet network_definition; do
  [[ -n $network_name ]] || continue

  definition_to_apply=$network_definition
  if @virsh@ --connect "$libvirt_uri" net-info "$network_name" >/dev/null 2>&1; then
    existing_uuid="$(@virsh@ --connect "$libvirt_uri" net-uuid "$network_name")"
    if [[ ! $existing_uuid =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
      printf 'Network %s returned invalid UUID %s. Refusing to redefine it.\n' \
        "$network_name" "$existing_uuid" >&2
      exit 1
    fi

    temporary_network_definition="$(@mktemp@ "${TMPDIR:-/tmp}/libvirt-workstation-network.XXXXXX.xml")"
    @python@ @xmlHelper@ preserve-uuid network "$network_name" "$existing_uuid" \
      "$network_definition" >"$temporary_network_definition"
    definition_to_apply=$temporary_network_definition
  fi

  # net-define changes only the persistent definition. An already active
  # network keeps running until the operator deliberately restarts it.
  @virsh@ --connect "$libvirt_uri" net-define "$definition_to_apply" --validate >/dev/null
  if [[ -n $temporary_network_definition ]]; then
    @rm@ -f -- "$temporary_network_definition"
    temporary_network_definition=
  fi
  @virsh@ --connect "$libvirt_uri" net-autostart "$network_name" >/dev/null

  if ! @virsh@ --connect "$libvirt_uri" net-info "$network_name" |
    @grep@ --extended-regexp '^Active:[[:space:]]+yes$' >/dev/null; then
    @virsh@ --connect "$libvirt_uri" net-start "$network_name" >/dev/null
  fi
done <"$network_manifest"

if @virsh@ --connect "$libvirt_uri" pool-info "$pool_name" >/dev/null 2>&1; then
  existing_pool_path="$(@virsh@ --connect "$libvirt_uri" pool-dumpxml --inactive "$pool_name" |
    @python@ @xmlHelper@ pool-path)"
  if [[ $existing_pool_path != "$pool_path" ]]; then
    printf 'Storage pool %s already targets %s, expected %s. Refusing to replace state.\n' \
      "$pool_name" "$existing_pool_path" "$pool_path" >&2
    exit 1
  fi
  existing_pool_uuid="$(@virsh@ --connect "$libvirt_uri" pool-uuid "$pool_name")"
  if [[ ! $existing_pool_uuid =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
    printf 'Storage pool %s returned an invalid UUID. Refusing to redefine it.\n' "$pool_name" >&2
    exit 1
  fi
  temporary_pool_definition="$(@mktemp@ "${TMPDIR:-/tmp}/libvirt-workstation-pool.XXXXXX.xml")"
  @python@ @xmlHelper@ preserve-uuid pool "$pool_name" "$existing_pool_uuid" \
    "$pool_definition" >"$temporary_pool_definition"
  pool_definition=$temporary_pool_definition
fi

# An active pool keeps running; the updated definition takes effect on its next
# start. Never stop a pool while guests may be using its images.
@virsh@ --connect "$libvirt_uri" pool-define "$pool_definition" --validate >/dev/null

@virsh@ --connect "$libvirt_uri" pool-autostart "$pool_name" >/dev/null
if ! @virsh@ --connect "$libvirt_uri" pool-info "$pool_name" |
  @grep@ --extended-regexp '^State:[[:space:]]+running$' >/dev/null; then
  @virsh@ --connect "$libvirt_uri" pool-start "$pool_name" >/dev/null
fi
@virsh@ --connect "$libvirt_uri" pool-refresh "$pool_name" >/dev/null

# Missing domains are expected before their one-time installation. Reconcile
# only the narrow autostart bit here; domain hardware belongs to its defining
# module.
while IFS=$'\t' read -r guest_name _ssh_host _exclusive_group _required_profile guest_autostart _inhibit_sleep; do
  [[ -n $guest_name ]] || continue
  if @virsh@ --connect "$libvirt_uri" dominfo "$guest_name" >/dev/null 2>&1; then
    if [[ $guest_autostart == 1 ]]; then
      @virsh@ --connect "$libvirt_uri" autostart "$guest_name" >/dev/null
    else
      @virsh@ --connect "$libvirt_uri" autostart "$guest_name" --disable >/dev/null
    fi
  fi
done <"$guest_manifest"
