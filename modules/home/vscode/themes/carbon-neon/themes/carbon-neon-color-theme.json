  "tokenColors": [
    {
      "settings": {
        "foreground": "#D9D9D9",
        "background": "#0A0A0A"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7A7A80",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "constant.other.symbol"],
      "settings": { "foreground": "#A3C679" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#CD775C" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "entity.name.tag"],
      "settings": { "foreground": "#A178C4" }
    },
    {
      "scope": ["entity.name.function", "support.function", "variable.function"],
      "settings": { "foreground": "#6A90D0" }
    },
    {
      "scope": ["variable", "variable.parameter", "support.variable"],
      "settings": { "foreground": "#D9D9D9" }
    },
    {
      "scope": ["entity.name.type", "support.type", "entity.other.inherited-class"],
      "settings": { "foreground": "#6EBAD7" }
    },
    {
      "scope": ["entity.name.section", "markup.heading"],
      "settings": { "foreground": "#D5B05F", "fontStyle": "bold" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#D36768" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#6EBAD7",
    "type": "#6EBAD7",
    "class": "#6EBAD7",
    "interface": "#6EBAD7",
    "enum": "#6EBAD7",
    "typeParameter": "#80CBC4",
    "parameter": "#D9D9D9",
    "variable": "#D9D9D9",
    "property": "#80CBC4",
    "enumMember": "#CD775C",
    "function": "#6A90D0",
    "method": "#6A90D0",
    "macro": "#A178C4",
    "keyword": "#A178C4",
    "string": "#A3C679",
    "number": "#CD775C",
    "regexp": "#D6808F",
    "operator": "#80CBC4",
    "decorator": "#D5B05F"
  }
}
