{
  "$schema": "vscode://schemas/color-theme",
  "name": "Carbon Neon",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "@accent@",
    "foreground": "@text@",
    "descriptionForeground": "@muted@",
    "errorForeground": "@danger@",
    "widget.shadow": "@surface@99",
    "textLink.foreground": "@accent@",
    "textLink.activeForeground": "@success@",
    "textCodeBlock.background": "@surfaceHover@",
    "selection.background": "@accent@40",
    "textPreformat.foreground": "@info@",
    "button.background": "@accent@",
    "button.foreground": "@surface@",
    "button.hoverBackground": "@success@",
    "button.secondaryBackground": "@surfaceHover@",
    "button.secondaryForeground": "@text@",
    "button.secondaryHoverBackground": "@outline@",
    "badge.background": "@accent@",
    "badge.foreground": "@surface@",
    "activityBarBadge.background": "@accent@",
    "activityBarBadge.foreground": "@surface@",
    "progressBar.background": "@accent@",
    "input.background": "@surfaceHover@",
    "input.foreground": "@text@",
    "input.border": "@scrollbar@",
    "input.placeholderForeground": "@muted@",
    "inputOption.activeBorder": "@accent@",
    "inputOption.activeBackground": "@accent@26",
    "inputValidation.infoBackground": "@surfaceHover@",
    "inputValidation.infoBorder": "@info@",
    "inputValidation.warningBackground": "@surfaceHover@",
    "inputValidation.warningBorder": "@warning@",
    "inputValidation.errorBackground": "@surfaceHover@",
    "inputValidation.errorBorder": "@danger@",
    "dropdown.background": "@surfaceHover@",
    "dropdown.border": "@scrollbar@",
    "menu.background": "@surfaceHover@",
    "menu.foreground": "@text@",
    "menu.selectionBackground": "@outline@",
    "menu.selectionForeground": "@textStrong@",
    "menu.separatorBackground": "@outline@",
    "editorWidget.background": "@surfaceHover@",
    "editorWidget.foreground": "@text@",
    "editorWidget.border": "@scrollbar@",
    "quickInput.background": "@surfaceHover@",
    "quickInput.foreground": "@text@",
    "pickerGroup.border": "@outline@",
    "pickerGroup.foreground": "@accent@",
    "keybindingLabel.background": "@surfaceRaised@",
    "keybindingLabel.foreground": "@text@",
    "keybindingLabel.border": "@outlineSubtle@",
    "keybindingLabel.bottomBorder": "@outline@",
    "notifications.background": "@surfaceHover@",
    "notifications.foreground": "@text@",
    "notifications.border": "@scrollbar@",
    "notificationLink.foreground": "@accent@",
    "notificationsErrorIcon.foreground": "@danger@",
    "notificationsWarningIcon.foreground": "@warning@",
    "notificationsInfoIcon.foreground": "@info@",
    "notificationCenter.border": "@outline@",
    "notificationCenterHeader.background": "@surfaceRaised@",
    "notificationCenterHeader.foreground": "@text@",
    "banner.background": "@surfaceHover@",
    "banner.foreground": "@text@",
    "banner.iconForeground": "@accent@",
    "titleBar.activeBackground": "@surface@",
    "titleBar.activeForeground": "@text@",
    "titleBar.inactiveBackground": "@surface@",
    "titleBar.inactiveForeground": "@muted@",
    "titleBar.border": "@surfaceHover@",
    "activityBar.background": "@surface@",
    "activityBar.foreground": "@text@",
    "activityBar.inactiveForeground": "@muted@",
    "activityBar.activeBorder": "@accent@",
    "activityBarTop.background": "@surfaceChrome@",
    "activityBarTop.foreground": "@text@",
    "activityBarTop.inactiveForeground": "@muted@",
    "activityBarTop.activeBorder": "@accent@B3",
    "sideBar.background": "@surface@",
    "sideBar.foreground": "@text@",
    "sideBar.border": "@outline@",
    "sideBarSectionHeader.background": "@surfaceRaised@",
    "sideBarSectionHeader.foreground": "@text@",
    "editorGroup.border": "@outline@",
    "editorGroupHeader.tabsBackground": "@surfaceChrome@",
    "editorGroupHeader.tabsBorder": "@surfaceHover@",
    "tab.activeBackground": "@surface@",
    "tab.activeForeground": "@textStrong@",
    "tab.activeBorderTop": "@accent@B3",
    "tab.inactiveBackground": "@surfaceChrome@",
    "tab.inactiveForeground": "@muted@",
    "editor.background": "@surface@",
    "editor.foreground": "@text@",
    "editorCursor.foreground": "@cursor@",
    "editor.selectionBackground": "@accent@40",
    "editor.inactiveSelectionBackground": "@accent@26",
    "editor.lineHighlightBackground": "@surfaceRaised@",
    "editorLineNumber.foreground": "@lineNumber@",
    "editorLineNumber.activeForeground": "@text@",
    "editorIndentGuide.background1": "@outlineSubtle@",
    "editorIndentGuide.activeBackground1": "@outline@",
    "editorWhitespace.foreground": "@outline@",
    "editorBracketMatch.background": "@accent@26",
    "editorBracketMatch.border": "@accent@",
    "editorGutter.background": "@surface@",
    "editorGutter.addedBackground": "@diffAdded@99",
    "editorGutter.deletedBackground": "@diffRemoved@99",
    "editorError.foreground": "@danger@",
    "editorWarning.foreground": "@warning@",
    "editorInfo.foreground": "@info@",
    "editorHint.foreground": "@accent@",
    "list.activeSelectionBackground": "@surfaceHover@",
    "list.activeSelectionForeground": "@textStrong@",
    "list.inactiveSelectionBackground": "@surfaceRaised@",
    "list.hoverBackground": "@surfaceHover@",
    "list.focusOutline": "@accent@",
    "scrollbar.shadow": "@surface@66",
    "scrollbarSlider.background": "@scrollbar@66",
    "scrollbarSlider.hoverBackground": "@muted@88",
    "scrollbarSlider.activeBackground": "@accent@99",
    "editorOverviewRuler.addedForeground": "@diffAdded@CC",
    "editorOverviewRuler.deletedForeground": "@diffRemoved@CC",
    "minimapGutter.addedBackground": "@diffAdded@99",
    "minimapGutter.deletedBackground": "@diffRemoved@99",
    "diffEditor.insertedLineBackground": "@diffAdded@26",
    "diffEditor.insertedTextBackground": "@diffAdded@33",
    "diffEditor.removedLineBackground": "@diffRemoved@26",
    "diffEditor.removedTextBackground": "@diffRemoved@33",
    "diffEditor.border": "@outlineSubtle@",
    "diffEditor.diagonalFill": "@surfaceHover@",
    "statusBar.background": "@surface@",
    "statusBar.foreground": "@muted@",
    "statusBar.border": "@surfaceHover@",
    "statusBar.debuggingBackground": "@special@",
    "statusBar.debuggingForeground": "@surface@",
    "statusBar.debuggingBorder": "@special@",
    "statusBar.noFolderBackground": "@surface@",
    "statusBar.noFolderForeground": "@muted@",
    "statusBar.noFolderBorder": "@surfaceHover@",
    "statusBar.focusBorder": "@accent@",
    "statusBarItem.activeBackground": "@surfaceHover@",
    "statusBarItem.hoverForeground": "@textStrong@",
    "statusBarItem.hoverBackground": "@surfaceHover@",
    "statusBarItem.compactHoverBackground": "@surfaceHover@",
    "statusBarItem.focusBorder": "@accent@",
    "statusBarItem.prominentBackground": "@surfaceRaised@",
    "statusBarItem.prominentForeground": "@muted@",
    "statusBarItem.prominentHoverBackground": "@surfaceHover@",
    "statusBarItem.prominentHoverForeground": "@textStrong@",
    "statusBarItem.remoteBackground": "@surfaceRaised@",
    "statusBarItem.remoteForeground": "@muted@",
    "statusBarItem.remoteHoverBackground": "@surfaceHover@",
    "statusBarItem.remoteHoverForeground": "@textStrong@",
    "statusBarItem.errorBackground": "@danger@",
    "statusBarItem.errorForeground": "@surface@",
    "statusBarItem.errorHoverBackground": "@base0F@",
    "statusBarItem.errorHoverForeground": "@surface@",
    "statusBarItem.warningBackground": "@warning@",
    "statusBarItem.warningForeground": "@surface@",
    "statusBarItem.warningHoverBackground": "@cursor@",
    "statusBarItem.warningHoverForeground": "@surface@",
    "statusBarItem.offlineBackground": "@surfaceHover@",
    "statusBarItem.offlineForeground": "@muted@",
    "statusBarItem.offlineHoverBackground": "@scrollbar@",
    "statusBarItem.offlineHoverForeground": "@textStrong@",
    "panel.background": "@surface@",
    "panel.border": "@outline@",
    "terminal.background": "@surface@",
    "terminal.foreground": "@text@",
    "terminalCursor.foreground": "@cursor@",
    "terminal.ansiBlack": "@outline@",
    "terminal.ansiRed": "@danger@",
    "terminal.ansiGreen": "@success@",
    "terminal.ansiYellow": "@warning@",
    "terminal.ansiBlue": "@syntaxFunction@",
    "terminal.ansiMagenta": "@special@",
    "terminal.ansiCyan": "@info@",
    "terminal.ansiWhite": "@text@",
    "terminal.ansiBrightBlack": "@muted@",
    "terminal.ansiBrightRed": "@base0F@",
    "terminal.ansiBrightGreen": "@success@",
    "terminal.ansiBrightYellow": "@cursor@",
    "terminal.ansiBrightBlue": "@accent@",
    "terminal.ansiBrightMagenta": "@special@",
    "terminal.ansiBrightCyan": "@info@",
    "terminal.ansiBrightWhite": "@textStrong@"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "@text@"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "@muted@",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "constant.other.symbol"],
      "settings": { "foreground": "@success@" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "@base09@" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "entity.name.tag"],
      "settings": { "foreground": "@special@" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": { "foreground": "@syntaxFunction@" }
    },
    {
      "scope": ["variable", "variable.parameter", "support.variable"],
      "settings": { "foreground": "@text@" }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "@info@" }
    },
    {
      "scope": ["entity.name.section", "markup.heading"],
      "settings": { "foreground": "@warning@", "fontStyle": "bold" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "@danger@" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "@info@",
    "type": "@info@",
    "class": "@info@",
    "interface": "@info@",
    "enum": "@info@",
    "typeParameter": "@accent@",
    "parameter": "@text@",
    "variable": "@text@",
    "property": "@accent@",
    "enumMember": "@base09@",
    "function": "@syntaxFunction@",
    "method": "@syntaxFunction@",
    "macro": "@special@",
    "keyword": "@special@",
    "string": "@success@",
    "number": "@base09@",
    "regexp": "@base0F@",
    "operator": "@accent@",
    "decorator": "@warning@"
  }
}
