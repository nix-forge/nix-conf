general {
  lock_cmd = pidof hyprlock || hyprlock
  # Wait for Hyprlock to confirm the lock before logind permits sleep.
  inhibit_sleep = 3
  before_sleep_cmd = loginctl lock-session
  after_sleep_cmd = hyprctl eval 'hl.dpms({ action = "on" })'
  on_lock_cmd = @onLockCommand@
  on_unlock_cmd = hyprctl eval 'hl.dpms({ action = "on" })'
}

listener {
  timeout = @lockAfterSeconds@
  on-timeout = loginctl lock-session
}

listener {
  timeout = @displayOffAfterSeconds@
  on-timeout = hyprctl eval 'hl.dpms({ action = "off" })'
  on-resume = hyprctl eval 'hl.dpms({ action = "on" })'
}

listener {
  timeout = @suspendAfterSeconds@
  on-timeout = systemctl suspend
}
