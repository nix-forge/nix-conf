@define-color surface @base00@;
@define-color surface-raised @base01@;
@define-color surface-hover @base02@;
@define-color outline @base03@;
@define-color muted @base04@;
@define-color text @base05@;
@define-color red @base08@;
@define-color orange @base09@;
@define-color yellow @base0A@;
@define-color green @base0B@;
@define-color accent @base0D@;

* {
  border: 0;
  border-radius: 0;
  box-shadow: none;
  font-family: @font@;
  font-size: 14px;
  font-weight: 500;
  min-height: 0;
}

window {
  background: transparent;
  color: @text;
}

#bar,
popover contents {
  background: alpha(@surface, 0.88);
  border: 1px solid alpha(@outline, 0.72);
  border-radius: 14px;
}

#bar {
  padding: 0 10px;
}

#start,
#center,
#end {
  margin: 0 2px;
}

button,
.workspaces .item,
.launcher .item,
.music,
.volume,
.bluetooth,
.notifications,
.tray,
.clock,
.network,
.focused {
  border-radius: 10px;
  margin: 5px 2px;
  padding: 0 9px;
}

button:hover,
.workspaces .item:hover,
.launcher .item:hover {
  background: alpha(@surface-hover, 0.88);
}

.workspaces .item.focused,
.launcher .item.focused {
  background: alpha(@accent, 0.22);
  box-shadow: inset 0 -2px @accent;
}

.workspaces .item.visible,
.launcher .item.open {
  box-shadow: inset 0 -2px @muted;
}

.workspaces .item.urgent {
  background: alpha(@red, 0.30);
}

.focused {
  color: @muted;
}

.clock {
  color: @text;
  font-weight: 600;
}

.volume,
.bluetooth,
.network,
.notifications,
.power-menu {
  color: @text;
}

.notifications .count {
  background: @accent;
  border-radius: 999px;
  color: @surface;
  font-size: 10px;
  font-weight: 700;
  min-width: 15px;
  padding: 1px 4px;
}

.popup {
  padding: 14px;
}

.popup-clock .calendar-clock,
.popup-power-menu #header {
  font-size: 18px;
  font-weight: 650;
  margin-bottom: 10px;
}

.popup-clock .calendar .today {
  background: alpha(@accent, 0.25);
  border-radius: 8px;
}

.popup-volume .device-box {
  border-right: 1px solid alpha(@outline, 0.65);
  margin-right: 14px;
  padding-right: 14px;
}

scale trough {
  background: alpha(@outline, 0.65);
  border-radius: 999px;
  min-height: 6px;
}

scale highlight {
  background: @accent;
  border-radius: 999px;
}

scale slider {
  background: @text;
  border-radius: 999px;
  min-height: 14px;
  min-width: 14px;
}

.popup-power-menu #buttons > * + * {
  margin-left: 8px;
}

.popup-power-menu .power-action {
  background: alpha(@surface-raised, 0.9);
  border: 1px solid alpha(@outline, 0.7);
  border-radius: 12px;
  min-width: 50px;
  min-height: 46px;
}

.popup-power-menu .power-action:hover {
  background: alpha(@accent, 0.23);
  border-color: @accent;
}

.popup-power-menu .power-action label {
  font-size: 20px;
}
