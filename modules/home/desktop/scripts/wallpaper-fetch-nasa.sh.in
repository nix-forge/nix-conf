#!@bash@
set -euo pipefail
export PATH="@runtimePath@"
umask 077

cache_directory='@wallpaperDirectory@'
state_directory='@stateDirectory@'
source_archive_directory="$cache_directory/.originals"
temporary_directory="$(mktemp -d)"
trap 'rm -rf -- "$temporary_directory"' EXIT
mkdir -p -- "$cache_directory" "$state_directory" "$source_archive_directory"
chmod 700 -- "$cache_directory" "$state_directory" "$source_archive_directory"

queries_json=@queriesJson@
rejected_terms_json=@rejectedTermsJson@

# SVS contains data products, title cards, and production stills as well as
# unusually good wallpapers. Search only visual-oriented topics chosen in Nix
# and reject records whose metadata calls them out as unsuitable.
page_id=''
page_json=''
candidate=''
attempts=0
while IFS= read -r query; do
  [ "$attempts" -ge @maxCandidatePages@ ] && break
  api_json="$temporary_directory/search-$attempts.json"
  if ! curl --fail --proto '=https' --tlsv1.2 \
    --connect-timeout 15 --max-time 60 --max-filesize 5242880 \
    --get --data-urlencode "search=$query" --data-urlencode 'limit=80' \
    --output "$api_json" 'https://svs.gsfc.nasa.gov/api/search/'; then
    continue
  fi

  mapfile -t page_ids < <(jq -r '.results[] | select(.result_type == "Visualization") | .id' "$api_json" | shuf)
  for candidate_page_id in "${page_ids[@]}"; do
    [ "$attempts" -ge @maxCandidatePages@ ] && break 2
    attempts=$((attempts + 1))
    candidate_json="$temporary_directory/page-$candidate_page_id.json"
    if ! curl --fail --proto '=https' --tlsv1.2 \
      --connect-timeout 15 --max-time 20 --max-filesize 10485760 \
      --output "$candidate_json" "https://svs.gsfc.nasa.gov/api/$candidate_page_id/"; then
      continue
    fi

    candidate_value="$(jq -r --argjson rejected_terms "$rejected_terms_json" '
      ([.title?, .keywords?] | flatten | map(select(type == "string")) | join(" ") | ascii_downcase) as $metadata
      | select(all($rejected_terms[]; . as $term | ($metadata | contains($term | ascii_downcase) | not)))
      | [ .. | objects
        | select(.media_type? == "Image")
        | select((.url? | type) == "string" and (.url | startswith("https://svs.gsfc.nasa.gov/")))
        | select((.width? // 0) >= 3840 and (.height? // 0) >= 2160 and .width >= .height)
        | { url, width, height, pixels: (.pixels // (.width * .height)) }
      ] | sort_by(.pixels) | last // empty | @base64' "$candidate_json")"
    [ -n "$candidate_value" ] || continue
    page_id="$candidate_page_id"
    page_json="$candidate_json"
    candidate="$candidate_value"
    break 2
  done
done < <(jq -r '.[]' <<< "$queries_json" | shuf)
[ -n "$candidate" ]

media_url="$(echo "$candidate" | base64 -d | jq -r '.url')"
width="$(echo "$candidate" | base64 -d | jq -r '.width')"
height="$(echo "$candidate" | base64 -d | jq -r '.height')"
download_file="$temporary_directory/image"

curl --fail --proto '=https' --tlsv1.2 \
  --connect-timeout 15 --max-time 180 --max-filesize @maxFileSizeBytes@ \
  --output "$download_file" "$media_url"

mime_type="$(file --brief --mime-type -- "$download_file")"
converted=0
original_extension=''
case "$mime_type" in
  image/avif) extension=avif ;;
  image/jpeg) extension=jpg ;;
  image/png) extension=png ;;
  image/tiff) extension=tiff ;;
  image/webp) extension=webp ;;
  image/x-exr|image/vnd.radiance|image/x-hdr)
    original_extension=exr
    converted=1
    ;;
  image/heic|image/heif)
    original_extension=heif
    converted=1
    ;;
  image/jxl)
    original_extension=jxl
    converted=1
    ;;
  image/bmp|image/x-ms-bmp)
    original_extension=bmp
    converted=1
    ;;
  *) echo "SVS file was not an accepted wallpaper image ($mime_type)." >&2; exit 65 ;;
esac

if [ "$converted" -eq 1 ]; then
  original_file="$download_file"
  download_file="$temporary_directory/display.png"
  '@normalizeSdr@' "$original_file" "$download_file"
  extension=png
fi

dimensions="$(magick identify -ping -format '%w %h' -- "$download_file")"
[ "$(printf '%s' "$dimensions" | cut -d ' ' -f 1)" -ge 3840 ]
[ "$(printf '%s' "$dimensions" | cut -d ' ' -f 2)" -ge 2160 ]

checksum="$(sha256sum -- "$download_file" | cut -d ' ' -f 1)"
destination="$cache_directory/nasa-svs-$page_id-$checksum.$extension"
if [ ! -e "$destination" ]; then
  install -m 600 -- "$download_file" "$destination"
  if [ "$converted" -eq 1 ] && [ '@keepOriginals@' -eq 1 ]; then
    install -m 600 -- "$original_file" "$source_archive_directory/nasa-svs-$page_id-$checksum.source.$original_extension"
  fi
  jq -n \
    --arg id "$page_id" --arg url "$media_url" --arg title "$(jq -r '.title // ""' "$page_json")" \
    --arg retrieved_at "$(date --iso-8601=seconds)" \
    --arg checksum "$checksum" --arg source_mime "$mime_type" \
    --arg conversion "$(if [ "$converted" -eq 1 ]; then printf '%s' '16-bit sRGB PNG SDR derivative'; fi)" \
    --argjson width "$width" --argjson height "$height" \
    '{ source: "NASA Scientific Visualization Studio", source_id: $id, url: $url,
      title: $title, license: "NASA SVS public domain unless otherwise noted",
      retrieved_at: $retrieved_at, sha256: $checksum, source_mime: $source_mime,
      conversion: $conversion, width: $width, height: $height }' \
    > "$destination.json"
  chmod 600 -- "$destination.json"
fi

# Each accepted image is bounded in size, and the private cache is bounded in
# count. The currently displayed file is never pruned.
current_file="$(cat "$state_directory/current" 2>/dev/null || true)"
mapfile -d "" files < <(find "$cache_directory" -maxdepth 1 -type f \
  \( -name 'nasa-svs-*.avif' -o -name 'nasa-svs-*.jpg' -o -name 'nasa-svs-*.png' \
    -o -name 'nasa-svs-*.tiff' -o -name 'nasa-svs-*.webp' \) \
  -printf '%T@:%p\\0' | sort -z -n)
excess=$((${#files[@]} - @maxImages@))
if [ "$excess" -gt 0 ]; then
  removed=0
  for entry in "${files[@]}"; do
    [ "$removed" -ge "$excess" ] && break
    stale_file="${entry#*:}"
    [ "$stale_file" = "$current_file" ] && continue
    rm -f -- "$stale_file" "$stale_file.json"
    stale_basename="$(basename -- "$stale_file")"
    stale_basename="${stale_basename%.*}"
    find "$source_archive_directory" -maxdepth 1 -type f -name "${stale_basename}.source.*" -delete
    removed=$((removed + 1))
  done
fi
