$env.config.keybindings ++= [
  {
    name: delete_previous_word
    modifier: control
    keycode: char_w
    mode: [emacs vi_insert]
    event: { edit: backspaceword }
  }
  {
    name: delete_to_line_start
    modifier: control
    keycode: char_u
    mode: [emacs vi_insert]
    event: { edit: cutfromlinestart }
  }
]
