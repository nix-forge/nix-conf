<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!-- Private-use assignments are font/protocol-specific. The generated
      aliases accept the provider only after a family that is actually
      installed in this profile; an unavailable first family must still let
      the browser continue to the next CSS family. -->
  <description>
    Add the configured legacy provider after installed named families only.
  </description>
  <!-- Color-emoji fonts commonly claim private-use slots without carrying
      the Apple-specific glyph assignments. Keep the provider behind that
      protocol family so ordinary text still prefers the preceding web/UI
      families, while a missing private-use glyph can continue to it. -->
  <match target="pattern">
    <test qual="any" name="family" compare="eq">
      <string>@appleColorEmojiFamily@</string>
    </test>
    <edit name="family" mode="append" binding="weak">
      <string>@privateUseFallbackFamily@</string>
    </edit>
  </match>
  <include>@privateUseFamilyAliases@</include>
</fontconfig>
