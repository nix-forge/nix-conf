# shellcheck shell=bash
watch_file flake.lock
watch_file flake/partitions.nix
watch_file flake/dev/flake.nix
watch_file flake/dev/flake.lock
watch_file flake/dev/formatter.nix
watch_file flake/dev/git-hooks.nix
watch_file flake/dev/shell.nix
watch_file flake/dev/javascript-tools.nix
watch_file lib/writers/bash.nix
watch_file lib/templates/text.nix
watch_file flake/dev/rust-workspaces.nix
watch_file flake/dev/rust-policy.yml
watch_file flake/dev/rust-tooling.nix
watch_file flake/dev/kani.nix
watch_file Cargo.toml
watch_file Cargo.lock
watch_file flake/runtime-packages.nix
watch_file flake/rust-workspace.nix
watch_file scripts/typescript/projects.json

if has nix_direnv_version; then
  nix_direnv_disallow_fallback
  use flake
else
  nix_dev_env="$(nix print-dev-env --accept-flake-config)" || return 1
  eval "$nix_dev_env" || return 1
  unset nix_dev_env
fi

# This desktop helper validates the mounted scratch filesystem and owns the
# cache lifecycle. Each checkout gets separate Cargo outputs and locks.
if has desktop-task-cache && [[ -z ${CARGO_TARGET_DIR:-} ]]; then
  checkout_key="$(printf '%s\n' "$PWD" | sha256sum)" || return 1
  cargo_scratch="$(desktop-task-cache "nix-conf-${checkout_key:0:16}")" || return 1
  export CARGO_TARGET_DIR="$cargo_scratch/target"
  export CARGO_BUILD_BUILD_DIR="${CARGO_BUILD_BUILD_DIR:-$cargo_scratch/build}"
  unset checkout_key cargo_scratch
fi
