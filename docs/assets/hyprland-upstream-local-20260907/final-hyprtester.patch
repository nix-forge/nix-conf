+static SDispatchResult expectSubsurfaceAncestry(int orphanDepth, uint32_t rootId, uint32_t childId) {
+    for (const auto& sub : PROTO::subcompositor->m_surfaces) {
+        if (!sub->m_surface || wl_resource_get_id(sub->m_surface->m_resource->resource()) != childId)
+            continue;
+
+        if (orphanDepth) {
+            if (sub->t1Parent())
+                return {.success = false, .error = "Destroyed parent still resolves"};
+            const double OFFSET = orphanDepth == 1 ? 30 : 50;
+            if (sub->posRelativeToParent() != Vector2D{OFFSET, OFFSET})
+                return {.success = false, .error = "Wrong orphan offset"};
+            if (sub->m_surface->getPreferredImageDescription() != g_pCompositor->getPreferredImageDescription())
+                return {.success = false, .error = "Orphan did not use the default image description"};
+            return {};
+        }
+
+        const auto ROOT = sub->t1Parent();
+        const auto POS  = sub->posRelativeToParent();
+        if (!ROOT || ROOT->client() != sub->m_surface->client() || wl_resource_get_id(ROOT->m_resource->resource()) != rootId || POS != Vector2D{60, 60})
+            return {.success = false,
+                    .error   = std::format("Expected root {} and offset 60,60; got root {} and offset {},{}", rootId, ROOT ? wl_resource_get_id(ROOT->m_resource->resource()) : 0,
+                                           POS.x, POS.y)};
+        return {};
+    }
+
+    return {.success = false, .error = "Nested child not found"};
+}
+
+static int luaExpectSubsurfaceAncestry(lua_State* L) {
+    return luaResult(L, ::expectSubsurfaceAncestry(luaL_checkinteger(L, 1), luaL_checkinteger(L, 2), luaL_checkinteger(L, 3)));
+}
+
+static int luaExpectSubsurfaceCleanup(lua_State* L) {
+    return luaResult(L, PROTO::subcompositor->m_surfaces.empty() ? SDispatchResult{} : SDispatchResult{.success = false, .error = "Subsurface resources remain"});
+}
+
+static CHyprSignalListener subsurfaceRoleTeardownListener;
+static SDispatchResult     subsurfaceRoleTeardownResult;
+
+static int                 luaArmSubsurfaceRoleTeardown(lua_State* L) {
+    const auto ROOT_ID           = luaL_checkinteger(L, 1);
+    const auto CHILD_ID          = luaL_checkinteger(L, 2);
+    subsurfaceRoleTeardownResult = {.success = false, .error = "Expired role notification was not observed"};
+    for (const auto& sub : PROTO::subcompositor->m_surfaces) {
+        if (!sub->m_surface || wl_resource_get_id(sub->m_surface->m_resource->resource()) != CHILD_ID)
+            continue;
+        const auto                      PARENT     = sub->m_parent.lock();
+        const WP<CWLSubsurfaceResource> PARENT_SUB = sc<CSubsurfaceRole*>(PARENT->m_role.get())->m_subsurface;
+        subsurfaceRoleTeardownListener             = PARENT_SUB->m_events.destroy.listen([PARENT_SUB, ROOT_ID, CHILD_ID]() {
+            // destroy() emits with the resource alive; the destructor emits again
+            // after its last strong owner is gone, before resetting the surface role.
+            if (!PARENT_SUB.expired())
+                return;
+            subsurfaceRoleTeardownResult = expectSubsurfaceAncestry(1, ROOT_ID, CHILD_ID);
+        });
+        return luaResult(L, {});
+    }
+    return luaResult(L, {.success = false, .error = "Nested child not found"});
+}
+
+static int luaExpectSubsurfaceRoleTeardown(lua_State* L) {
+    subsurfaceRoleTeardownListener.reset();
+    return luaResult(L, subsurfaceRoleTeardownResult);
+}
