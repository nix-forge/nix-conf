+// Wait for a frame from the deepest child so teardown exercises mapped views,
+// including the damage path, rather than only destroying protocol resources.
+static bool createNestedChildren(SWlState& state) {
+    state.nestedBuffer = createBuffer(state, 64, 64);
+    if (!state.nestedBuffer)
+        return false;
+
+    auto parent = state.surface;
+    for (size_t i = 0; i < state.nestedSurfaces.size(); ++i) {
+        auto& surface    = state.nestedSurfaces[i];
+        auto& subsurface = state.nestedSubsurfaces[i];
+        surface          = makeShared<CCWlSurface>(state.compositor->sendCreateSurface());
+        subsurface       = makeShared<CCWlSubsurface>(state.subcompositor->sendGetSubsurface(surface.get(), parent.get()));
+        subsurface->sendSetPosition(10 * (i + 1), 10 * (i + 1));
+        surface->sendAttach(state.nestedBuffer.get(), 0, 0);
+        parent = surface;
+    }
+
+    bool       frameDone = false;
+    const auto FRAME     = makeShared<CCWlCallback>(state.nestedSurfaces.back()->sendFrame());
+    FRAME->setDone([&frameDone](CCWlCallback*, uint32_t) { frameDone = true; });
+    for (auto& surface : std::views::reverse(state.nestedSurfaces))
+        surface->sendCommit();
+    state.surface->sendCommit();
+
+    return waitForDisplayState(state, [&frameDone]() { return frameDone; }, 100, 100);
+}
