+    for (auto& surface : surfaces)
+        surface = makeShared<CCWlSurface>(state.compositor->sendCreateSurface());
+    for (size_t i = 1; i < surfaces.size(); ++i)
+        subsurfaces[i] = makeShared<CCWlSubsurface>(state.subcompositor->sendGetSubsurface(surfaces[i].get(), surfaces[i - 1].get()));
+
+    // The root has no role, but its deepest descendant is still an invalid parent.
+    subsurfaces[0] = makeShared<CCWlSubsurface>(state.subcompositor->sendGetSubsurface(surfaces.front().get(), surfaces.back().get()));
+    if (wl_display_roundtrip(state.display) >= 0)
