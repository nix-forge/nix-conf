+    // The root has no role, but its deepest descendant is still an invalid parent.
+    subsurfaces[0] = makeShared<CCWlSubsurface>(state.subcompositor->sendGetSubsurface(surfaces.front().get(), surfaces.back().get()));
+    if (wl_display_roundtrip(state.display) >= 0)
+        return false;
