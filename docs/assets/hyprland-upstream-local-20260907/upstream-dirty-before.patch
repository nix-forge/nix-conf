+    const wl_interface* interface = nullptr;
+    const auto          ERROR     = wl_display_get_protocol_error(state.display, &interface, nullptr);
+    return interface && std::string_view{interface->name} == "wl_subcompositor" && ERROR == WL_SUBCOMPOSITOR_ERROR_BAD_PARENT;
