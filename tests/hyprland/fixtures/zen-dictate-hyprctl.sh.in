#!@bash@
# shellcheck shell=bash
# Controlled fixture environment.
# shellcheck disable=SC2154
count_file="$MOCK_STATE/focus-count"
count=0
if [[ -f $count_file ]]; then read -r count <"$count_file"; fi
count=$((count + 1))
printf '%s\n' "$count" >"$count_file"
if [[ ${MOCK_FOCUS_CHANGES:-0} == 1 && $count -gt 1 ]]; then
  printf '{"class":"firefox","address":"0x2"}\n'
else
  printf '{"class":"zen-beta","address":"0x1"}\n'
fi
